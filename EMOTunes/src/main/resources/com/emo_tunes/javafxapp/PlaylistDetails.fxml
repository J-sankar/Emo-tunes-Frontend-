<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<ScrollPane fx:id="detailsRoot" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.emo_tunes.javafxapp.PlaylistDetailsController"
            fitToWidth="true">
    <VBox fx:id="songsContainerVBox" alignment="TOP_CENTER" spacing="20" style="-fx-padding: 20;">
        <HBox spacing="20" alignment="CENTER_LEFT">
            <ImageView fx:id="coverImage" fitHeight="150" fitWidth="150"/>
            <VBox alignment="CENTER_LEFT" spacing="8">
                <Label fx:id="playlistName" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
                <Label fx:id="songCount" style="-fx-font-size: 16px; -fx-text-fill: gray;"/>
            </VBox>
        </HBox>
        <VBox fx:id="songsContainer" spacing="10" style="-fx-padding: 20 0 0 0;">
            <Label text="Songs" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
        </VBox>
        <Button fx:id="backBtn" text="← Back" onAction="#handleBack"/>
    </VBox>
</ScrollPane>
